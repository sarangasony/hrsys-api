generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              Int          @id @default(autoincrement())
  legacyCompanyId Int?         @unique @map("legacy_company_id")
  code            String       @unique @db.VarChar(30)
  name            String       @db.VarChar(200)
  address         String?      @db.VarChar(500)
  etfRegNo        String?      @map("etf_reg_no") @db.VarChar(100)
  sapCode         String?      @map("sap_code") @db.VarChar(50)
  level0Id        Int?         @map("level_0_id")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  departments     Department[]

  @@map("companies")
}

model Department {
  id                 Int      @id @default(autoincrement())
  companyId          Int      @map("company_id")
  legacyDepartmentId Int?     @map("legacy_department_id")
  code               String   @db.VarChar(30)
  name               String   @db.VarChar(200)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("departments")
}

model Division {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("divisions")
}

model Section {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("sections")
}

model Branch {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("branches")
}

model Floor {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("floors")
}

model JobCategory {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("job_categories")
}

model Designation {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("designations")
}

model EmploymentType {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("employment_types")
}

model Country {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10)
  name      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("countries")
}

enum LookupType {
  TITLE
  MARITAL
  BLOOD
  RELIGION
  RACE
  NATIONALITY
}

model Lookup {
  id        Int        @id @default(autoincrement())
  type      LookupType
  code      String     @db.VarChar(30)
  label     String     @db.VarChar(150)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([type, code])
  @@index([type, label])
  @@map("lookups")
}
